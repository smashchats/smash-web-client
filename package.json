{
    "name": "smash-web",
    "private": true,
    "version": "0.2.0",
    "type": "module",
    "description": "A web client implementation of the Smash Protocol using React, TypeScript, and Vite",
    "scripts": {
        "build:lib": "cd smash-node-lib && npm install && npm run build",
        "dev": "npm run build:lib && vite --mode development",
        "build": "npm run build:lib && tsc && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext ts,tsx --fix",
        "format": "prettier --write .",
        "prepare": "husky",
        "lint-staged": "lint-staged",
        "dev:mocks": "tsx tests/mocks/dev.ts",
        "dev:test": "npm run build:lib && vite --mode test --env-file .env.test",
        "e2e": "concurrently -k -s first -n Mocks,App,Tests \"npm:dev:mocks\" \"npm:dev:test\" \"playwright test\"",
        "e2e:headed": "concurrently -k -s first -n Mocks,App,Tests \"npm:dev:mocks\" \"npm:dev:test\" \"playwright test --headed\"",
        "e2e:ui": "concurrently -k -s first -n Mocks,App,Tests \"npm:dev:mocks\" \"npm:dev:test\" \"playwright test --ui\"",
        "test:e2e": "playwright test"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "author": "USL Unstatic Labs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/smashchats/smash-web"
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.1.13",
        "@radix-ui/react-visually-hidden": "^1.2.2",
        "@tailwindcss/vite": "^4.1.5",
        "2key-ratchet": "^1.0.18",
        "date-fns": "^4.1.0",
        "dexie": "^4.0.11",
        "i18next": "^25.0.2",
        "lucide-react": "^0.539.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-i18next": "^15.5.1",
        "react-router-dom": "^7.5.3",
        "smash-node-lib": "./smash-node-lib/",
        "tailwindcss": "^4.1.5",
        "vite-plugin-node-polyfills": "^0.23.0",
        "vite-plugin-pwa": "^1.0.0",
        "zustand": "^5.0.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@playwright/test": "^1.54.2",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.4.1",
        "concurrently": "^9.2.0",
        "eslint": "^9.25.0",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.0.0",
        "prettier": "^3.5.3",
        "socket.io": "^4.8.1",
        "tsx": "^4.20.4",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5"
    }
}
