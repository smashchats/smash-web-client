{
    "files": [],
    "references": [
        { "path": "./tsconfig.app.json" },
        { "path": "./tsconfig.node.json" }
    ],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "smash-node-lib/*": ["smash-node-lib/*"],
            "@app/*": ["src/app/*"],
            "@components/*": ["src/components/*"],
            "@features/*": ["src/features/*"],
            "@hooks/*": ["src/hooks/*"],
            "@services/*": ["src/services/*"],
            "@styles/*": ["src/styles/*"],
            "@types/*": ["src/types/*"],
            "@utils/*": ["src/utils/*"]
        }
    }
}
